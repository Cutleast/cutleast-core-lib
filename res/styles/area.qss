/* Groupboxes */
QGroupBox {
    background-color: ${colors.bg_base};
    border: ${metrics.border_width} solid ${colors.border};
    border-radius: ${metrics.radius_l};
    color: ${texts.subtitle.color};
    font-family: '${texts.subtitle.family}';
    font-size: ${texts.subtitle.size};
    font-weight: ${texts.subtitle.weight};
    margin-top: 30px;
    padding: ${metrics.spacing_s};
}

QGroupBox::title {
    background-color: ${colors.bg_base};
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding-top: 20px;
    padding-left: 10px;
    margin-right: 5px;
}

QGroupBox::indicator:checked {
    background-color: ${colors.primary};
    image: url(${resources.checkmark});
}

QGroupBox::indicator:checked:hover {
    background-color: ${colors.primary_bg_hover};
    border-color: ${colors.surface_hover};
}
QGroupBox::indicator:checked:disabled {
    background-color: ${texts.secondary.color};
}

/* Section Area Widget */
SectionAreaWidget {
    background-color: ${colors.bg_base};
}
SectionAreaWidget > QPushButton#toggle_button {
    background-color: transparent;
    border-color: transparent;
}
SectionAreaWidget > QPushButton#toggle_button:hover {
    background-color: ${colors.surface_hover};
}
SectionAreaWidget > QPushButton#toggle_button:pressed {
    background-color: ${colors.surface_pressed};
}

/* Flexcontainer */
FlexContainer DragHandle {
    qproperty-handleSize: 18;
}

FlexContainer DropIndicator {
    qproperty-indicatorColor: ${colors.primary};
}

FlexContainer PanelTile #flex_tile_title {
    font-size: ${texts.subtitle.size};
}

/* Dividers */
Divider {
    background-color: ${colors.border};
    border: none;
}

Divider[orientation="horizontal"] {
    min-height: ${metrics.border_width};
    max-height: ${metrics.border_width};
    margin: ${metrics.spacing} 0;
}

Divider[orientation="vertical"] {
    min-width: ${metrics.border_width};
    max-width: ${metrics.border_width};
    margin: 0 ${metrics.spacing};
}
