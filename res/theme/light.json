    "texts": {
        "title": {
            "color": "${neutral_palette.tone_0}"
        },
        "subtitle": {
            "color": "${neutral_palette.tone_10}"
        },
        "text": {
            "color": "${neutral_palette.tone_20}"
        },
        "secondary": {
            "color": "${neutral_palette.tone_40}"
        }
    },
    "resources": {
        "arrow_down": ":/core-lib/icons/light/arrow_down.svg",
        "arrow_down_disabled": ":/core-lib/icons/disabled/arrow_down.svg",
        "arrow_left": ":/core-lib/icons/light/arrow_left.svg",
        "arrow_left_disabled": ":/core-lib/icons/disabled/arrow_left.svg",
        "arrow_right": ":/core-lib/icons/light/arrow_right.svg",
        "arrow_right_disabled": ":/core-lib/icons/disabled/arrow_right.svg",
        "arrow_up": ":/core-lib/icons/light/arrow_up.svg",
        "arrow_up_disabled": ":/core-lib/icons/disabled/arrow_up.svg",
        "checkmark": ":/core-lib/icons/light/checkmark.svg"
    },
    "meta": {
        "checked_bg": "${primary_palette.tone_70}",
        "checked_bg_hover": "${primary_palette.tone_80}",
        "checked_bg_disabled": "${neutral_palette.tone_50}",
        "window_bg": "#ffffff"
