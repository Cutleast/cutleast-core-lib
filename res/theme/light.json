        "error_bg": "${error_palette.tone_90}",
        "error_bg_hover": "${error_palette.tone_80}",
        "error_bg_pressed": "${error_palette.tone_70}",
        "error_bg_disabled": "${colors.surface_disabled}",
        "caution": "${caution_palette.tone_50}",
        "caution_fg": "${caution_palette.tone_40}",
        "caution_bg": "${caution_palette.tone_90}",
        "caution_bg_hover": "${caution_palette.tone_80}",
        "caution_bg_pressed": "${caution_palette.tone_70}",
        "caution_bg_disabled": "${colors.surface_disabled}",
        "warning": "${warning_palette.tone_50}",
        "warning_fg": "${warning_palette.tone_40}",
        "warning_bg": "${warning_palette.tone_95}",
        "warning_bg_hover": "${warning_palette.tone_90}",
        "warning_bg_pressed": "${warning_palette.tone_80}",
        "warning_bg_disabled": "${colors.surface_disabled}",
        "success": "${success_palette.tone_50}",
        "success_fg": "${success_palette.tone_40}",
        "success_bg": "${success_palette.tone_95}",
        "success_bg_hover": "${success_palette.tone_90}",
        "success_bg_pressed": "${success_palette.tone_80}",
        "success_bg_disabled": "${colors.surface_disabled}",
        "information": "${information_palette.tone_50}",
        "information_fg": "${information_palette.tone_40}",
        "information_bg": "${information_palette.tone_90}",
