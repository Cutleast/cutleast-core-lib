        "border": "${neutral_palette.tone_80}",
        "border_strong": "${neutral_palette.tone_60}",
        // Effect colors
        "shadow": "#46000000",
        // Primary colors
        "primary": "${primary_palette.tone_50}",
        "primary_fg": "${primary_palette.tone_40}",
        "primary_bg": "${primary_palette.tone_90}",
        "primary_bg_hover": "${primary_palette.tone_80}",
        "primary_bg_pressed": "${primary_palette.tone_70}",
        "primary_bg_disabled": "${colors.surface_disabled}",
