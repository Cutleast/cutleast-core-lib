{
    "ui_mode": "Light",
    "colors": {
        // Background colors
        "bg_base": "${neutral_palette.tone_100}",
        "bg_subtle": "${neutral_palette.tone_95}",
        "bg_elevated": "${neutral_palette.tone_80}",
        // Surface colors
        "surface": "${neutral_palette.tone_95}",
        "surface_hover": "${neutral_palette.tone_90}",
        "surface_pressed": "${neutral_palette.tone_80}",
        "surface_selected": "${colors.primary_bg}",
        "surface_disabled": "${neutral_palette.tone_100}",
